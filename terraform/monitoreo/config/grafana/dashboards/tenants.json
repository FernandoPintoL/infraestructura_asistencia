     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Errores del backend (5xx)",
   "description": "Porcentaje de respuestas con error del servidor. La alerta se dispara sobre 5 %.",
   "datasource": {
    "type": "prometheus",
