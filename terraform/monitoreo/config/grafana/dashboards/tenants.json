      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", tenant=~\"$tenant\", entorno=~\"$entorno\"} / node_filesystem_size_bytes{mountpoint=\"/\", tenant=~\"$tenant\", entorno=~\"$entorno\"})",
     "legendFormat": "{{tenant}} · {{servicio}}"
