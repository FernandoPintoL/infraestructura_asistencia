   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tenant, estado) (rate(asistencia_http_peticiones_total{tenant=~\"$tenant\", entorno=~\"$entorno\"}[5m]))",
