     },
     "expr": "100 * sum by (tenant) (rate(asistencia_http_peticiones_total{estado=\"5xx\", tenant=~\"$tenant\", entorno=~\"$entorno\"}[5m])) / sum by (tenant) (rate(asistencia_http_peticiones_total{tenant=~\"$tenant\", entorno=~\"$entorno\"}[5m]))",
