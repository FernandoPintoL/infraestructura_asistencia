  {
   "id": 10,
   "type": "timeseries",
   "title": "Latencia p95",
   "description": "El 95 % de las peticiones responde en menos de este tiempo.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, tenant) (rate(asistencia_http_latencia_segundos_bucket{tenant=~\"$tenant\", entorno=~\"$entorno\"}[5m])))",
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
