{
 "uid": "asistencia-tenants",
 "title": "Asistencia · Salud de los tenants",
 "description": "Disponibilidad, CPU, memoria, latencia, errores y base de datos de cada tenant (RF-25 a RF-27).",
 "tags": [
  "asistencia",
  "tenants"
 ],
 "timezone": "browser",
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "templating": {
  "list": [
   {
    "name": "entorno",
    "label": "Entorno",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(up, entorno)",
     "refId": "entorno"
    },
    "definition": "label_values(up, entorno)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   },
   {
    "name": "tenant",
    "label": "Tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(up{entorno=~\"$entorno\"}, tenant)",
     "refId": "tenant"
    },
    "definition": "label_values(up{entorno=~\"$entorno\"}, tenant)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Salud (disponibilidad y estado de los servicios)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Disponibilidad en el período",
   "description": "Porcentaje de pruebas de punta a punta (frontend → API → base) que respondieron bien.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 10,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * avg by (tenant, entorno) (avg_over_time(probe_success{job=\"disponibilidad\", tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__range]))",
     "legendFormat": "{{tenant}} · {{entorno}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 99
       },
       {
        "color": "green",
        "value": 99.9
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "alertlist",
   "title": "Alertas activas",
   "description": "Alertas que están disparadas ahora. La plataforma también las muestra en su sección Alertas.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 1,
    "w": 14,
    "h": 6
   },
   "targets": [],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "viewMode": "list",
    "groupMode": "default",
    "maxItems": 20,
    "sortOrder": 1,
    "stateFilter": {
     "firing": true,
     "pending": true,
     "noData": false,
     "normal": false,
     "error": true
    },
    "alertInstanceLabelFilter": "",
    "dashboardAlerts": false,
    "showInstances": true
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Estado de cada servicio",
   "description": "Arriba = Prometheus puede leer sus métricas.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=~\"node|postgres|django\", tenant=~\"$tenant\", entorno=~\"$entorno\"}",
     "legendFormat": "{{tenant}} · {{servicio}} · {{job}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Caído",
         "color": "red"
        },
        "1": {
         "text": "Arriba",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "row",
   "title": "Uso de recursos (CPU, memoria, disco)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - 100 * avg by (tenant, servicio) (rate(node_cpu_seconds_total{mode=\"idle\", tenant=~\"$tenant\", entorno=~\"$entorno\"}[5m]))",
     "legendFormat": "{{tenant}} · {{servicio}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Memoria",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{tenant=~\"$tenant\", entorno=~\"$entorno\"} / node_memory_MemTotal_bytes{tenant=~\"$tenant\", entorno=~\"$entorno\"})",
     "legendFormat": "{{tenant}} · {{servicio}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Disco raíz",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
